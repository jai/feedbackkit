// The FeedbackKit Worker (docs/worker.md): one Worker on Jai's personal Cloudflare account that keeps every app's
// feedback. Render it to wrangler.jsonc beside it (gitignored) by filling the placeholder, then
// `npx wrangler deploy --config ../deploy/wrangler.jsonc` from worker/. Secrets, with `wrangler secret
// put`: CALLER_TOKEN (the app Workers' FEEDBACKKIT_TOKEN), RUNNER_TOKEN (the runner's) and ISSUES_TOKEN (opens issues).
{
  "name": "featurekit",
  "account_id": "__CLOUDFLARE_ACCOUNT_ID__",
  "main": "../worker/src/featurekit.ts",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "observability": { "enabled": true },
  "vars": {
    // Where screenshots are served (issue links): this Worker's own workers.dev URL.
    "PUBLIC_URL": "__PUBLIC_URL__",
    // Per app: its repo, who ships (owners), who opens PRs (builders), whether everyone else files an issue, and how it
    // names a sender when its Worker does not say (names).
    "APPS": "{\"prhub\":{\"repo\":\"jai/prhub\",\"owners\":[\"jai\"],\"builders\":[\"poom\"],\"issues\":true,\"names\":{\"jai\":\"Jai\"}},\"agent-pager\":{\"repo\":\"jai/agent-pager\",\"owners\":[\"jai\"],\"names\":{\"jai\":\"Jai\"}},\"trips\":{\"repo\":\"jai/trips\",\"owners\":[\"jai\"],\"names\":{\"jai\":\"Jai\"}}}"
  },
  "r2_buckets": [{ "binding": "FEEDBACK", "bucket_name": "featurekit" }],
  // The one durable store: chats, messages, delivery states, coding threads (worker/migrations, applied with
  // `npx wrangler d1 migrations apply feedbackkit --remote --config ../deploy/wrangler.jsonc`).
  "d1_databases": [
    { "binding": "DB", "database_name": "feedbackkit", "database_id": "__D1_DATABASE_ID__", "migrations_dir": "../worker/migrations" }
  ],
  // The runner's long poll (worker/src/runner-wake.ts): a message sent wakes the runner's held /runner/wait.
  "durable_objects": { "bindings": [{ "name": "RUNNER_WAKE", "class_name": "RunnerWake" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RunnerWake"] }]
}
